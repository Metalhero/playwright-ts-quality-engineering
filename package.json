{
    "name": "playwright-ts-quality-engineering",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "scripts": {
        "test": "playwright test",
        "test:ui": "playwright test --ui",
        "typecheck": "tsc --noEmit",
        "doctor": "node scripts/doctor.mjs",
        "lint": "eslint . --max-warnings 0",
        "lint:fix": "eslint . --fix",
        "lint:check-fix": "eslint . --fix-dry-run --format json",
        "verify": "npm run doctor -- --check-install && npm run lint && npm run typecheck && npm test -- --project=chromium",
        "trace": "playwright show-trace trace.zip"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Metalhero/playwright-ts-quality-engineering.git"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/Metalhero/playwright-ts-quality-engineering/issues"
    },
    "homepage": "https://github.com/Metalhero/playwright-ts-quality-engineering#readme",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "@types/node": "^26.6.5",
        "eslint-plugin-playwright": "^2.12.1",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.1"
    }
}